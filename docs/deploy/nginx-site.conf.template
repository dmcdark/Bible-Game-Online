# Render ONLY ${GAME_DOMAIN}, ${GAME_CERT_FILE}, ${GAME_KEY_FILE} with envsubst.
# Match the existing listeners. Never add listen 443: rw-core owns it.
server {
    listen 127.0.0.1:8443 ssl http2;
    listen [::1]:8443 ssl;
    server_name ${GAME_DOMAIN};

    ssl_certificate "${GAME_CERT_FILE}";
    ssl_certificate_key "${GAME_KEY_FILE}";

    server_tokens off;
    access_log /var/log/nginx/bible-game.access.log bible_game_json;
    error_log /var/log/nginx/bible-game.error.log warn;

    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;

    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=bible_game_http burst=120 nodelay;
    limit_conn bible_game_connections 100;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite these headers; $remote_addr can still be the REALITY proxy.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $bible_game_connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;

    location /socket.io/ {
        limit_req zone=bible_game_socket burst=60 nodelay;
        proxy_pass http://127.0.0.1:13000;
    }

    location /api/ {
        client_max_body_size 2k;
        proxy_pass http://127.0.0.1:13000;
    }

    location / {
        proxy_pass http://127.0.0.1:13000;
    }
}
